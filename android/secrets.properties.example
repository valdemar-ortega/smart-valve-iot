# Copy this file to "secrets.properties" (same folder) and fill in your values.
# secrets.properties is git-ignored: your credentials never reach the repo.

# --- MQTT broker (same one the ESP32 publishes to) ---
mqtt.host=your-cluster.s1.eu.hivemq.cloud
mqtt.port=8883
mqtt.username=your-mqtt-user
mqtt.password=your-mqtt-password
mqtt.topic.pressure=smartvalve/pressure
mqtt.topic.status=smartvalve/status

# --- Valve backend (see backend/README section of the main README) ---
# Must end with "/" and use https.
backend.url=https://your-backend.onrender.com/
backend.apiKey=the-same-API_KEY-you-set-in-the-backend
